# AIOS configuration
# Copy to .env and adjust. Never commit real secrets.
# The Go core reads these first; the Python planner reads the provider block.

AIOS_API_HOST=127.0.0.1
AIOS_API_PORT=8000
AIOS_API_URL=http://127.0.0.1:8000
AIOS_PROC_ROOT=/proc
AIOS_SYS_ROOT=/sys
AIOS_POLICY_DIR=aios/policies

# OPA is evaluated with the local binary. If it cannot run, policy fails
# closed with `policy_unavailable`.
AIOS_OPA_BINARY=opa
AIOS_OPA_TIMEOUT_S=2
AIOS_MAX_READ_BYTES=1048576
AIOS_MAX_DIR_ENTRIES=2000

# Model provider used by the Python planner: groq (external, opt-in) or
# ollama (local). The Go core never calls a model.
AIOS_MODEL_PROVIDER=ollama
AIOS_ALLOW_EXTERNAL_MODEL=false
AIOS_GROQ_API_KEY=
AIOS_GROQ_BASE_URL=https://api.groq.com/openai/v1
AIOS_GROQ_MODEL=llama-3.1-8b-instant
AIOS_GROQ_TIMEOUT_S=30.0
AIOS_GROQ_MAX_TOKENS=1024
AIOS_GROQ_TEMPERATURE=0.0

AIOS_OLLAMA_URL=http://127.0.0.1:11434
AIOS_OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
AIOS_OLLAMA_TIMEOUT_S=60.0

# Reversible cleanup. Quarantine must be on the same filesystem as the
# approved targets. Set AIOS_APPROVAL_SECRET for approvals that survive a
# restart; an empty value uses an ephemeral key.
AIOS_QUARANTINE_DIR=~/.local/state/aios/quarantine
AIOS_APPROVAL_SECRET=
AIOS_APPROVAL_TTL_S=900

# Durable audit trail. An empty path uses an in-memory ledger.
AIOS_LEDGER_PATH=~/.local/state/aios/ledger.jsonl
