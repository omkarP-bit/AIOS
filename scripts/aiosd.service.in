[Unit]
Description=AIOS host control core
Documentation=file://@AIOS_DIR@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@AIOS_DIR@
ExecStart=@AIOS_BIN@
Environment=AIOS_API_HOST=127.0.0.1
Environment=AIOS_API_PORT=8000
Environment=AIOS_POLICY_DIR=@AIOS_DIR@/aios/policies
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=default.target
